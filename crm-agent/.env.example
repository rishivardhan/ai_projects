# Required for the agent (the data layer, tools and RAG work without it)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: point at a real MongoDB. Unset = embedded mongomock persisted to data/crm_snapshot.json
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=crm

# Optional agent tuning
# CRM_MODEL=claude-opus-5-5
# CRM_EFFORT=medium          # low | medium | high | xhigh | max
# CRM_FALLBACKS=1            # server-side refusal fallbacks (set 0 to disable)
